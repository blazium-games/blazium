<?xml version="1.0" encoding="UTF-8" ?>
<class name="Newgrounds" inherits="Object" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
	<brief_description>
		Newgrounds.io export.
	</brief_description>
	<description>
		Unlocks medals, submits scores, and reads or writes cloud saves. Secure calls wait in a queue until the player is signed in.
	</description>
	<tutorials>
	</tutorials>
	<methods>
		<method name="cloud_load">
			<return type="String" />
			<param index="0" name="key" type="String" />
			<description>
				Requests a cloud save. The value arrives through [signal result].
			</description>
		</method>
		<method name="cloud_save">
			<return type="void" />
			<param index="0" name="key" type="String" />
			<param index="1" name="value" type="String" />
			<description>
				Writes a cloud save. The call is queued while signed out.
			</description>
		</method>
		<method name="get_last_error" qualifiers="const">
			<return type="String" />
			<description>
			</description>
		</method>
		<method name="is_on_host" qualifiers="const">
			<return type="bool" />
			<description>
			</description>
		</method>
		<method name="log_in">
			<return type="void" />
			<description>
				Opens the Newgrounds sign-in page.
			</description>
		</method>
		<method name="submit_score">
			<return type="void" />
			<param index="0" name="board" type="String" />
			<param index="1" name="score" type="int" />
			<description>
				Submits a score. The call is queued while signed out.
			</description>
		</method>
		<method name="unlock_medal">
			<return type="void" />
			<param index="0" name="id" type="int" />
			<description>
				Unlocks a medal. The call is queued while signed out.
			</description>
		</method>
	</methods>
	<signals>
		<signal name="paused">
			<description>
			</description>
		</signal>
		<signal name="result">
			<param index="0" name="json" type="String" />
			<description>
				Emitted when a host call returns a payload.
			</description>
		</signal>
		<signal name="resumed">
			<description>
			</description>
		</signal>
		<signal name="unavailable">
			<param index="0" name="message" type="String" />
			<description>
			</description>
		</signal>
	</signals>
</class>
